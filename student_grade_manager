class grade_app():

  def __init__(self):
    self.student_info = {}

  def __init__(self,name,grade):
    self.student_info = {}
    self.student_info["Name"] = name.capitalize()
    self.student_info["Grade"] = grade

  def add_student(self,student):
    if student.capitalize() == self.student_info["Name"] :
      print("Student already added")
    else: 
      self.student_info["Name"] = student

    return f"{student} added"

  def view_students(self):
    return self.students

  def student_search(self,student):
    if student in self.student_info:
      return student
    else: 
      return "Student not found"

  def remove_student(self, student):
    if student == self.student_info["name"]: 
      del self.student_info["name"]
    else: 
      print(f"{student} not there")

  def load_students(self):
    import json 
    import os

    if os.path.exists("Students.json"):
      with open("Students.json", "r") as f:
        students = json.load(f)
        return students
    else: 
      return "Student.json doesn't exist include the students to create"

  def save_students(self):
    import json
    with open("Students.json", "w") as f:
      json.dump(self.student_info, f, indent=2)



    


  

      


  
  

  